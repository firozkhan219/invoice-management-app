# MySQL/MariaDB connection string. URL-encode special password characters.
# Local/remote example: mysql://USER:PASSWORD@HOST:3306/DB_NAME
DATABASE_URL=

# Long random value used for application secrets. Use 32+ random characters.
AUTH_SECRET=

# 32-byte base64 key for encrypting sensitive bank fields.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BANK_FIELD_ENCRYPTION_KEY=

# Directory for private uploads/documents. Keep outside public browsing paths in production.
UPLOAD_DIR=uploads

# Public application URL. For HostingRaja production use https://app.decorativehandicraft.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production recommended:
# NODE_ENV=production
